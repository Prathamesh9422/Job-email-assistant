{
  "manifest_version": 3,
  "name": "Naukri Applied-Jobs Sync",
  "version": "1.0.0",
  "description": "Scrapes your Naukri applied-jobs history and syncs new applications into your job-triage dashboard.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.naukri.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Naukri Applied-Jobs Sync"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
